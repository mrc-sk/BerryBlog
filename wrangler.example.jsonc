{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-blog",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "在这里填你自己的 D1 ID（npx wrangler d1 create blog 会输出）",
      "migrations_dir": "schema"
    }
  ],
  "vars": {
    "SITE_NAME": "你的博客名",
    "SITE_TAGLINE": "一句话简介",
    "AUTHOR_NAME": "你的名字",
    "AUTHOR_BIO": "自我介绍",
    "AUTHOR_AVATAR": "",
    "GITHUB_URL": "",
    "X_URL": "",
    "EMAIL": "",
    "COMMENT_ENABLED": "1",
    "ITEMS_PER_PAGE": "8"
  }
}