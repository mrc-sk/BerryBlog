{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-blog",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "schema"
    }
  ],
  "vars": {
    "SITE_NAME": "Nova's Blog",
    "SITE_TAGLINE": "写代码，也写字",
    "AUTHOR_NAME": "Nova",
    "AUTHOR_BIO": "全栈开发者，喜欢折腾小工具。这里记录技术笔记与碎碎念。",
    "AUTHOR_AVATAR": "",
    "GITHUB_URL": "",
    "X_URL": "",
    "EMAIL": "",
    "COMMENT_ENABLED": "1",
    "ITEMS_PER_PAGE": "8"
  }
}